*.jks
*.keystore

# Machine-specific Flutter/Android paths
apps/mobile/android/local.properties
apps/mobile/android/.gradle/
apps/mobile/android/app/.cxx/

# Built app binaries
*.apk
*.aab

# Local SQLite database — holds real scan rows and food photos' metadata
apps/api/data/*.db
apps/api/data/*.sqlite
apps/api/data/*.sqlite3
apps/api/data/uploads/

