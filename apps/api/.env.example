# CalFit API configuration — copy to .env and fill in.
# .env is gitignored. Never commit real keys.

# development (default) or production. production refuses to start with a
# missing/weak secret, never falls back to local SQLite, and hides /docs.
APP_ENV=development

# --- Supabase (project in ap-south-1 / Mumbai) -------------------------------
# Dashboard -> Settings -> API. Check every key works: python -m src.check_config
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key. Not used by the backend; every table has RLS enabled with
# no policies, so this key can read nothing.
SUPABASE_PUBLISHABLE_KEY=

# SECRET. Bypasses RLS entirely — full read/write on every table.
# Get it from: Supabase dashboard -> Settings -> API -> service_role.
# It is deliberately not available through the Supabase MCP tools.
# Until this and SUPABASE_URL are both set, the backend silently falls back
# to local SQLite and everything still appears to work.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini ----------------------------------------------------------------
# SECRET. Use a paid-billing key with a spend cap: the free tier allows only
# ~20 requests/day and trains on what you send, so it must not receive
# health data. See docs/GEMINI_BILLING.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Per Gemini call; Cloud Run cuts the whole request at its own timeout.
GEMINI_TIMEOUT_SECONDS=25

# --- Auth ------------------------------------------------------------------
# SECRET. Signs the per-device tokens the backend issues. At least 32 chars.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Until this is set, /api/v1/auth/device and every protected route return 503.
AUTH_SECRET_KEY=
DEVICE_TOKEN_DAILY_CAP_PER_IP=20

# --- Prescription reading --------------------------------------------------
# Sends a prescription photo to Gemini. Leave false until the Gemini key is on
# the PAID tier (free tier trains on prompts). See docs/GEMINI_BILLING.md.
PRESCRIPTION_AI_ENABLED=false
PRESCRIPTION_DAILY_CAP=5
# Even when enabled, prescriptions only run on Vertex or after you set this to
# true, having checked in AI Studio that GEMINI_API_KEY's project has billing on.
GEMINI_PAID_TIER_CONFIRMED=false

# Proxies in front of the API that append to X-Forwarded-For: 0 locally,
# 1 on Cloud Run. Used for the per-IP device-registration cap.
TRUSTED_PROXY_HOPS=0

# --- Limits ----------------------------------------------------------------
DAILY_SCAN_CAP=50
MAX_SCAN_UPLOAD_BYTES=10485760

# --- CORS ------------------------------------------------------------------
# Comma-separated. Empty = localhost-only defaults. Never use "*".
CORS_ALLOWED_ORIGINS=

# --- Storage ---------------------------------------------------------------
STORAGE_BUCKET=calfit-scans

# --- Where Gemini runs (docs/AI_PROVIDER_OPTIONS.md) -----------------------
# developer_api = AI Studio key above. vertex = Vertex AI in India, signed in
# with the Cloud Run service account; GEMINI_API_KEY is then not needed.
GEMINI_BACKEND=developer_api
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
