<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (Android 8+). The OS composites the foreground on
  top of the background and masks the result into whatever shape the launcher
  prefers (circle, squircle, teardrop). Older OS versions fall back to the
  existing PNGs in mipmap-* folders.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_calfit_mark" />
</adaptive-icon>
