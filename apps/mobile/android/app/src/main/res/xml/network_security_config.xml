<?xml version="1.0" encoding="utf-8"?>
<!--
    CalFit network security config for release builds: HTTPS
    only, to anything. Debug and profile builds use src/debug and src/profile, which also
    allows cleartext to the local dev server (10.0.2.2, 127.0.0.1, localhost).
    Keeping that exception out of release means a mis-built release can't send
    health data unencrypted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
